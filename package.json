{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "check:edge-functions": "node --experimental-strip-types --check supabase/functions/scan-invoice/index.ts && node --experimental-strip-types --check supabase/functions/super-service/scan-invoice.ts && node --experimental-strip-types --check supabase/functions/generate-embeddings/index.ts && node --experimental-strip-types --check supabase/functions/backfill-materials-embeddings/index.ts && node --experimental-strip-types --check supabase/functions/ask-jarvis/index.ts && node --experimental-strip-types --check supabase/functions/create-employee/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "verify": "npm run lint && npm test && npm run check:edge-functions && npm run build",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:db:reset": "supabase db reset",
    "supabase:schema:pull": "supabase db pull --linked --declarative --strict-coverage",
    "drive-sync": "node --env-file-if-exists=.env.drive-sync.local scripts/drive-sync/cli.js",
    "drive-sync:once": "node --env-file-if-exists=.env.drive-sync.local scripts/drive-sync/cli.js --once"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^30.1.2",
    "supabase": "^2.120.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
