# Local daemon only. Copy to .env.drive-sync.local, which is ignored by Git.
JARVIS_SUPABASE_URL=https://your-project-ref.supabase.co
JARVIS_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JARVIS_DRIVE_SYNC_ROOT=G:\Mój dysk\_Jarvis\Projekty
JARVIS_DRIVE_SYNC_HOST=WORKSHOP-PC-1

# Optional tuning (defaults shown)
JARVIS_DRIVE_SYNC_DEBOUNCE_MS=3000
JARVIS_DRIVE_SYNC_POLL_MS=30000
JARVIS_DRIVE_SYNC_HEARTBEAT_MS=15000
JARVIS_DRIVE_SYNC_LEASE_SECONDS=45
